{
  "name": "film-vault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @film-vault/server --filter @film-vault/web dev",
    "build": "pnpm --filter @film-vault/shared typecheck && pnpm --filter @film-vault/server build && pnpm --filter @film-vault/web build",
    "test": "pnpm --filter @film-vault/server test",
    "typecheck": "pnpm -r typecheck",
    "db:seed": "pnpm --filter @film-vault/server db:seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
