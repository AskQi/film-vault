# 复制为 .env 并填写。.env 不进版本库。

# 单用户登录 PIN（生产环境必须修改，不能是 1234）
PIN=change-me

# 会话签名密钥：固定值，否则每次重启所有设备都要重新登录
# 生成：openssl rand -hex 32
SESSION_SECRET=please-generate-with-openssl

# 对外域名。默认用宿主机 nginx 部署时不需要；
# 启用 Caddy（docker compose --profile caddy up -d）时必填
SITE_ADDRESS=film.ddns.sharepeople.cn

# 高德 Web 服务 key，用于把 GPS 坐标解析成详细地址（可选）
# 申请：https://console.amap.com/ → 应用管理 → 添加 Key，服务平台选「Web 服务」
# 不填也能用：坐标照常记录，地址手动填写
AMAP_KEY=

# 可选
# PORT=3300
# TZ=Asia/Shanghai
